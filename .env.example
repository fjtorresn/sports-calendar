# Copiar a .env (que está en .gitignore) y ajustar los valores:
#   cp .env.example .env
# Estos valores son SOLO para desarrollo local. En producción se definen en el hosting.

ENVIRONMENT=development

# PostgreSQL (los usa el contenedor `db` para crear la base de datos)
POSTGRES_USER=sports
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sports_calendar

# URLs que usa la app. "localhost" sirve al correr la app fuera de Docker;
# dentro de docker compose se sobrescriben para apuntar a los servicios `db` y `redis`.
DATABASE_URL=postgresql+psycopg://sports:change-me@localhost:5432/sports_calendar
REDIS_URL=redis://localhost:6379/0
