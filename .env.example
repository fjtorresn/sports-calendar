# Copy to .env (which is git-ignored) and adjust the values:
#   cp .env.example .env
# These values are for LOCAL DEVELOPMENT ONLY. In production they are set by the host.

ENVIRONMENT=development

# PostgreSQL (used by the `db` container to create the database)
POSTGRES_USER=sports
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sports_calendar

# URLs used by the app. "localhost" works when running the app outside Docker;
# docker compose overrides them to point at the `db` and `redis` services.
DATABASE_URL=postgresql+psycopg://sports:change-me@localhost:5432/sports_calendar
REDIS_URL=redis://localhost:6379/0

# football-data.org API key (free plan): https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Base URL used to build iCal links
PUBLIC_BASE_URL=http://localhost:8000
